// For format details, see https://containers.dev/implementors/json_reference/
{
    "name": "backend_dev",
    "initializeCommand": "cd ${localWorkspaceFolder} && python3 scripts/bootstrap.py && touch .devcontainer/bash_history && { [ -s .devcontainer/docker-compose.host.yml ] || echo 'services: {}' > .devcontainer/docker-compose.host.yml; }",
    "dockerComposeFile": [
        "../docker-compose.local.yml",
        "docker-compose.devcontainer.yml",
        // Per-machine overrides, gitignored (initializeCommand creates an empty one).
        "docker-compose.host.yml"
    ],
    "init": true,
    "mounts": [
        {
            "source": "${localWorkspaceFolder}/.devcontainer/bash_history",
            "target": "/home/dev-user/.bash_history",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.ssh",
            "target": "/home/dev-user/.ssh",
            "type": "bind"
        }
    ],
    // Keep django alive for VS Code attach; app server starts in postAttach (see post-attach.sh).
    "overrideCommand": true,
    "service": "django",
    "remoteUser": "dev-user",
    "remoteEnv": {"PATH": "/home/dev-user/.venv/bin:${containerEnv:PATH}"},
    "workspaceFolder": "/app",
    "features": {
        // Same major as compose/local/frontend/Dockerfile.
        "ghcr.io/devcontainers/features/node:1": {
            "version": "26"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/guiyomh/features/just:0": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "forwardPorts": [8000, 8001, 8025, 5555],
    "portsAttributes": {
        "8000": { "label": "frontend" },
        "8001": { "label": "django API" },
        "8025": { "label": "mailpit" },
        "5555": { "label": "flower" }
    },
    // Set *default* container specific settings.json values on container create.
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                "python.defaultInterpreterPath": "/home/dev-user/.venv/bin/python",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.typeCheckingMode": "basic",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["backend"],
                "mypy-type-checker.path": ["/home/dev-user/.venv/bin/mypy"],
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "always"
                    }
                },
                "[svelte]": {
                    "editor.defaultFormatter": "svelte.svelte-vscode"
                },
                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                }
            },
            // https://code.visualstudio.com/docs/remote/devcontainerjson-reference#_vs-code-specific-properties
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "davidanson.vscode-markdownlint",
                "mrmlnc.vscode-duplicate",
                "editorconfig.editorconfig",
                // python
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.mypy-type-checker",
                "charliermarsh.ruff",
                // django
                "batisteo.vscode-django",
                "monosans.djlint",
                // frontend
                "svelte.svelte-vscode",
                "bradlc.vscode-tailwindcss",
                "esbenp.prettier-vscode",
                // tooling
                "ms-azuretools.vscode-containers",
                "nefrob.vscode-just-syntax",
                "anthropic.claude-code"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postAttachCommand": "bash .devcontainer/post-attach.sh"
}
