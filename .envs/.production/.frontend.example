# Production frontend (SvelteKit) environment.
# ------------------------------------------------------------------------------
NODE_ENV=production
# Must stay 3000: the image EXPOSEs it and Traefik routes to frontend:3000.
PORT=3000
HOST=0.0.0.0
API_TARGET=http://django:8000

# Public origin (used by SvelteKit for CSRF / cookies). Must match the URL
# users actually visit, e.g. https://example.com.
ORIGIN=https://example.com
