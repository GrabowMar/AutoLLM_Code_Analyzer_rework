{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autollm-code-analyzer/generation/requirements-spec.json",
  "title": "App requirement spec",
  "description": "Structured requirement JSON consumed by seed_generation_templates / backend.generation.seeding.seed_requirements. spec_schema_version 3 lists its models under data_models; v1/v2 specs (one data_model object) still validate.",
  "type": "object",
  "required": [
    "slug",
    "name",
    "category",
    "description",
    "backend_requirements",
    "frontend_requirements",
    "api_endpoints"
  ],
  "anyOf": [
    { "required": ["data_model"] },
    { "required": ["data_models"] }
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "description": "snake_case; convention is {domain}_{app_name}, e.g. crud_todo_list"
    },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "difficulty": {
      "type": "string",
      "enum": ["basic", "standard", "advanced"]
    },
    "spec_schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "3 = current format (data_models; endpoint auth/query/success_status). data_lint's rules beyond this schema apply from 3 on"
    },
    "backend_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "frontend_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "admin_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "api_endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "admin_api_endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "data_model": {
      "description": "Legacy (v1/v2): the spec's single model. v3 specs use data_models",
      "type": "object",
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "data_models": {
      "description": "v3: every model of the app, primary model first",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "model": {
      "type": "object",
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fields": { "$ref": "#/$defs/fields" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["method", "path", "description"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "WS"]
        },
        "path": { "type": "string", "pattern": "^/api/" },
        "description": { "type": "string", "minLength": 1 },
        "auth": {
          "description": "Who may call it: anyone, a signed-in user, or the admin account",
          "type": "string",
          "enum": ["public", "user", "admin"]
        },
        "query": {
          "description": "Query parameters: {name: what it does}",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "success_status": {
          "description": "Status of a successful call (200 when absent)",
          "type": "integer",
          "minimum": 200,
          "maximum": 399
        },
        "request": {},
        "response": {}
      }
    }
  }
}
