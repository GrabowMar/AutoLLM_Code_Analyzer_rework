package main

import (
	"encoding/json"
{% if not has_frontend %}
	"html/template"
{% endif %}
	"log"
	"net/http"
	"os"
{% if has_frontend %}
	"path/filepath"
	"strings"
{% endif %}
)

func health(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok"})
}
{% if has_frontend %}

// frontend serves the Vite build and falls back to index.html for client-side routes.
func frontend(dist string) http.Handler {
	files := http.FileServer(http.Dir(dist))
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if strings.HasPrefix(r.URL.Path, "/api/") {
			http.NotFound(w, r)
			return
		}
		target := filepath.Join(dist, filepath.Clean("/"+r.URL.Path))
		if info, err := os.Stat(target); err != nil || info.IsDir() {
			http.ServeFile(w, r, filepath.Join(dist, "index.html"))
			return
		}
		files.ServeHTTP(w, r)
	})
}
{% else %}

var pages = template.Must(template.ParseFiles("backend/templates/index.html"))

func index(w http.ResponseWriter, r *http.Request) {
	if r.URL.Path != "/" {
		http.NotFound(w, r)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	if err := pages.ExecuteTemplate(w, "index.html", map[string]string{"Title": "App"}); err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
	}
}
{% endif %}

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "{{ run.port }}"
	}
	mux := http.NewServeMux()
	mux.HandleFunc("GET /api/health", health)
{% if has_frontend %}
	mux.Handle("/", frontend("frontend/dist"))
{% else %}
	mux.HandleFunc("GET /", index)
{% endif %}
	log.Printf("listening on %s", port)
	log.Fatal(http.ListenAndServe("0.0.0.0:"+port, mux))
}
