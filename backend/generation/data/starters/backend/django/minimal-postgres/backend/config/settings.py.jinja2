"""Django settings."""

import os
import secrets
from pathlib import Path
from urllib.parse import unquote
from urllib.parse import urlsplit

BASE_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = Path(os.environ.get("DATA_DIR", "data")).resolve()

SECRET_KEY = os.environ.get("SECRET_KEY") or secrets.token_urlsafe(50)
DEBUG = False
ALLOWED_HOSTS = ["*"]

INSTALLED_APPS: list[str] = []
MIDDLEWARE = [
    "django.middleware.common.CommonMiddleware",
]
ROOT_URLCONF = "config.urls"
WSGI_APPLICATION = "config.wsgi.application"

# PostgreSQL, from DATABASE_URL (postgresql://user:password@host:port/name).
_DATABASE_URL = urlsplit(os.environ.get("DATABASE_URL", "postgresql://localhost/app"))
DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.postgresql",
        "NAME": unquote(_DATABASE_URL.path.lstrip("/")),
        "USER": unquote(_DATABASE_URL.username or ""),
        "PASSWORD": unquote(_DATABASE_URL.password or ""),
        "HOST": _DATABASE_URL.hostname or "",
        "PORT": str(_DATABASE_URL.port or ""),
    },
}

TEMPLATES = [
    {
        "BACKEND": "django.template.backends.django.DjangoTemplates",
        "DIRS": [BASE_DIR / "templates"],
        "APP_DIRS": False,
        "OPTIONS": {},
    },
]
{% if has_frontend %}

FRONTEND_DIST = BASE_DIR.parent / "frontend" / "dist"
{% endif %}

LANGUAGE_CODE = "en-us"
TIME_ZONE = "UTC"
