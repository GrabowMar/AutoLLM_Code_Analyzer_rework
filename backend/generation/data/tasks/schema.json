          "type": "string"
        },
        "csrf_endpoint": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Csrf Endpoint"
        },
        "login": {
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Login",
          "type": "string"
