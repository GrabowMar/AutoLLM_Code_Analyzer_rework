        "logout": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logout"
        },
        "register": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register"
        },
        "token_json_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Json Path"
        }
      },
      "required": [
        "login",
        "credential"
      ],
      "title": "AuthFlow",
      "type": "object"
    },
