    "CheckSpec": {
      "additionalProperties": false,
      "description": "A functional check (hand-written in ``TaskSpecContent.acceptance`` or compiler output).",
      "properties": {
        "actor": {
          "default": "user_a",
          "enum": [
            "anon",
            "user_a",
            "user_b",
