    "AuthFlow": {
      "additionalProperties": false,
      "description": "Used only by auth_mode ``spec_defined``; values are endpoint ids.",
      "properties": {
        "credential": {
          "enum": [
            "bearer",
            "cookie"
          ],
          "title": "Credential",
          "type": "string"
        },
        "csrf": {
          "default": "none",
