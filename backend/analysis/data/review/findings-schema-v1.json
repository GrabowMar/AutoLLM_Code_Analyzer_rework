{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "files_reviewed", "review_complete"],
  "properties": {
    "findings": {
      "type": "array",
      "description": "One entry per distinct issue occurrence. An empty list is a valid answer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "start_line",
          "end_line",
          "evidence",
          "title",
          "rationale",
          "category",
          "cwe",
          "severity",
          "confidence",
          "fix"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "Path of the file exactly as given in its FILE header."
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "description": "First line of the issue (the number before '|')."
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "description": "Last line of the issue, >= start_line."
          },
          "evidence": {
            "type": "string",
            "description": "1-3 consecutive lines copied verbatim from the cited lines, without the line-number prefix."
          },
          "title": {
            "type": "string",
            "description": "Short name of the issue."
          },
          "rationale": {
            "type": "string",
            "description": "Why this is a real problem in this code and what can go wrong."
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "secrets",
              "bug",
              "type",
              "maintainability",
              "dead_code",
              "duplication",
              "complexity",
              "style",
              "other"
            ]
          },
          "cwe": {
            "type": ["string", "null"],
            "pattern": "^CWE-[1-9][0-9]{0,4}$",
            "description": "Most specific CWE id (e.g. CWE-89) for a security weakness, else null."
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability that this is a real issue."
          },
          "fix": {
            "type": "string",
            "description": "Concrete change that resolves the issue."
          }
        }
      }
    },
    "files_reviewed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Paths of the files you reviewed in this message."
    },
    "review_complete": {
      "type": "boolean",
      "description": "True when every file in this message was reviewed in full."
    }
  }
}
