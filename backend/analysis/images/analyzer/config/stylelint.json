{
  "extends": ["stylelint-config-recommended"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind", "apply", "layer", "config", "screen", "variants", "responsive",
          "theme", "source", "utility", "variant", "custom-variant", "plugin", "reference"
        ]
      }
    ],
    "function-no-unknown": [true, {"ignoreFunctions": ["theme", "screen"]}]
  }
}
