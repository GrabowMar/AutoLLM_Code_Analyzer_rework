  "executors": ["single_shot", "restricted_agent"],
  "eval_levels": ["none", "static", "build", "functional", "security", "full"],
  "serving_tiers": ["standard", "flex", "batch", "auto_batch"],
  "knob_classes": {
    "C": "confound: changes what the model sees or how it samples (in generation_policy_hash) (19 knobs)",
    "R": "recorded limit: changes the outcome only through truncation or stopping (hashed; stop reason recorded) (17 knobs)",
    "O": "operational: cost, speed or scheduling only (recorded, never hashed) (25 knobs)",
    "S": "stopping/design: study-level rule that changes inference (in prereg_hash) (20 knobs)"
  },
